NODE_ENV=production
PORT=3000

# PostgreSQL (Liara private network URI host preferred)
DB_HOST=your-postgres-host
DB_PORT=5432
DB_USERNAME=root
DB_PASSWORD=your-password
DB_NAME=postgres

# false recommended in production after schema is ready
DB_SYNCHRONIZE=false

# Required in production
JWT_SECRET=replace-with-long-random-secret

# Comma-separated frontend origins, or * for all
CORS_ORIGIN=https://shop.example.com

# Optional
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
